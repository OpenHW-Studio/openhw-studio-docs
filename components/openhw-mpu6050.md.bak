<h2>Example Code</h2>
<p class="section-desc">Install the <strong>Adafruit_MPU6050</strong> library before running.</p>
<div class="code-block">
  <button class="copy-btn" onclick="copyCode(this)">Copy</button>
<pre><span class="kw">#include</span> <span class="str">&lt;Adafruit_MPU6050.h&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;Adafruit_Sensor.h&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;Wire.h&gt;</span>
Adafruit_MPU6050 mpu;
<span class="kw">void</span> <span class="fn">setup</span>() {
  Serial.<span class="fn">begin</span>(<span class="num">115200</span>);
  <span class="kw">if</span> (!mpu.<span class="fn">begin</span>()) {
    Serial.<span class="fn">println</span>(<span class="str">"Failed to find MPU6050"</span>);
    <span class="kw">while</span> (<span class="num">1</span>);
  }
}
<span class="kw">void</span> <span class="fn">loop</span>() {
  sensors_event_t a, g, temp;
  mpu.<span class="fn">getEvent</span>(&amp;a, &amp;g, &amp;temp);
  Serial.<span class="fn">print</span>(<span class="str">"Acc X: "</span>); Serial.<span class="fn">print</span>(a.acceleration.x);
  Serial.<span class="fn">print</span>(<span class="str">", Y: "</span>); Serial.<span class="fn">print</span>(a.acceleration.y);
  Serial.<span class="fn">print</span>(<span class="str">", Z: "</span>); Serial.<span class="fn">println</span>(a.acceleration.z);
  <span class="fn">delay</span>(<span class="num">500</span>);
}</pre>
</div>
<div class="note">💡 Use the context menu during simulation to adjust XYZ forces in real time.</div>
<script>
function copyCode(btn) {
  navigator.clipboard.writeText(btn.nextElementSibling.innerText).then(() => {
    btn.textContent = 'Copied!'; setTimeout(() => btn.textContent = 'Copy', 2000);
  });
}
function openSimulator() {
  const code = ["#include <Adafruit_MPU6050.h>","#include <Adafruit_Sensor.h>","#include <Wire.h>","Adafruit_MPU6050 mpu;","void setup() { Serial.begin(115200); if (!mpu.begin()) while (1); }","void loop() { sensors_event_t a, g, temp; mpu.getEvent(&a, &g, &temp); Serial.print(\"X: \"); Serial.println(a.acceleration.x); delay(500); }"].join("\n"); 
  const diagram = { 
    version:1, 
    board:"arduino_uno", 
    components:[
      {id:"uno_1",type:"openhw-arduino-uno",x:80,y:150,attrs:{}},
      {id:"mpu_1",type:"openhw-mpu6050",x:420,y:130,attrs:{}}
    ], 
    connections:[
      ["uno_1:5V","mpu_1:VCC","red",[]],
      ["uno_1:GND.2","mpu_1:GND","black",[]],
      ["uno_1:A4","mpu_1:SDA","yellow",[]],
      ["uno_1:A5","mpu_1:SCL","blue",[]]
    ], 
    code 
  }; 
  window.open("http://localhost:5173/simulator?circuit="+encodeURIComponent(JSON.stringify(diagram)),"_blank");
}
</script>

</div>

<h2>Pin Reference</h2>
<table class="pin-table">
<tr><th>Pin</th><th>Type</th><th>Description</th></tr>
<tr><td><span class="pin-name">INT</span></td><td><span class="pin-type output">output</span></td><td>Interrupt output</td></tr>
<tr><td><span class="pin-name">AD0</span></td><td><span class="pin-type input">input</span></td><td>I2C Slave Address LSB</td></tr>
<tr><td><span class="pin-name">XCL</span></td><td><span class="pin-type output">output</span></td><td>Auxiliary I2C Clock</td></tr>
<tr><td><span class="pin-name">XDA</span></td><td><span class="pin-type bidirectional">bidirectional</span></td><td>Auxiliary I2C Data</td></tr>
<tr><td><span class="pin-name">SDA</span></td><td><span class="pin-type bidirectional">bidirectional</span></td><td>I2C Data</td></tr>
<tr><td><span class="pin-name">SCL</span></td><td><span class="pin-type input">input</span></td><td>I2C Clock</td></tr>
<tr><td><span class="pin-name">GND</span></td><td><span class="pin-type input">input</span></td><td>Ground</td></tr>
<tr><td><span class="pin-name">VCC</span></td><td><span class="pin-type input">input</span></td><td>Power (3.3V or 5V)</td></tr>
</table>


<h2>Attributes</h2>
<table class="attrs-table">
<tr><th>Attribute</th><th>Default</th><th>Description</th></tr>
<tr><td><code>accelX</code></td><td><code>0</code></td><td>Configuration attribute for accelX</td></tr>
<tr><td><code>accelY</code></td><td><code>0</code></td><td>Configuration attribute for accelY</td></tr>
<tr><td><code>accelZ</code></td><td><code>1</code></td><td>Configuration attribute for accelZ</td></tr>
<tr><td><code>gyroX</code></td><td><code>0</code></td><td>Configuration attribute for gyroX</td></tr>
<tr><td><code>gyroY</code></td><td><code>0</code></td><td>Configuration attribute for gyroY</td></tr>
<tr><td><code>gyroZ</code></td><td><code>0</code></td><td>Configuration attribute for gyroZ</td></tr>
<tr><td><code>temperature</code></td><td><code>25</code></td><td>Configuration attribute for temperature</td></tr>
</table>


<h2>Example Code</h2>

```cpp
#include <Adafruit MPU6050.h>
#include <Adafruit Unified Sensor.h>

#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
Adafruit_MPU6050 mpu_1;

void setup() {
  if (!mpu_1.begin()) {
    Serial.println("Failed to find MPU6050 chip");
    while (1);
  }
}

void loop() {
  sensors_event_t a_1, g_1, temp_1;
  mpu_1.getEvent(&a_1, &g_1, &temp_1);
  Serial.print("Accel X: "); Serial.println(a_1.acceleration.x);
  delay(500);
}
```


